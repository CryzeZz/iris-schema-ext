{
  "name": "iris-schema",
  "displayName": "iris schema",
  "description": "%ext.description%",
  "version": "1.0.0",
  "publisher": "CryzeZz",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryzeZz/iris-schema-ext.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/iris-schema@256.png",
  "activationEvents": [
    "onCommand:irisSchema.openPanel",
    "onCommand:irisSchema.refreshConnections",
    "onCommand:irisSchema.clearPasswords",
    "onView:irisSchema.welcome"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "irisSchema",
          "title": "iris schema",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "irisSchema": [
        {
          "id": "irisSchema.welcome",
          "name": "%view.welcome.name%",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "irisSchema.welcome",
        "contents": "%view.welcome.contents%"
      }
    ],
    "commands": [
      {
        "command": "irisSchema.openPanel",
        "title": "%cmd.openPanel.title%",
        "category": "iris schema"
      },
      {
        "command": "irisSchema.refreshConnections",
        "title": "%cmd.refreshConnections.title%",
        "category": "iris schema"
      },
      {
        "command": "irisSchema.clearPasswords",
        "title": "%cmd.clearPasswords.title%",
        "category": "iris schema"
      }
    ],
    "configuration": {
      "title": "iris schema",
      "properties": {
        "irisSchema.configPath": {
          "type": "string",
          "default": "",
          "description": "%config.configPath.description%"
        },
        "irisSchema.sampleLimit": {
          "type": "number",
          "default": 100,
          "description": "%config.sampleLimit.description%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "irisSchema.openPanel",
          "when": "resourceExtname == .cls",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
